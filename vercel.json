{
  "version": 2,
  "builds": [
    { "src": "api/{auth,users,docs,index}.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/auth/(.*)", "dest": "api/auth.js" },
    { "src": "/api/users/(.*)", "dest": "api/users.js" },
    { "src": "/api-docs/(.*)", "dest": "api/docs.js" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ],
  "functions": {
    "api/auth.js": { "runtime": "nodejs18.x", "regions": ["hkg1"] },
    "api/users.js": { "runtime": "nodejs18.x", "regions": ["hkg1"] },
    "api/docs.js": { "runtime": "nodejs18.x", "regions": ["hkg1"] },
    "api/index.js": { "runtime": "nodejs18.x", "regions": ["hkg1"] }
  }
}